# Royal Affair API Configuration
APP_NAME=Royal Affair API
DEBUG=True
PORT=8000
HOST=127.0.0.1

# MongoDB Atlas / Local Connection Environment Variables
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=royal_affair_db

# Security & CORS
SECRET_KEY=your_super_secret_jwt_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000
